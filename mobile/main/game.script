-- Oyun dünyası: sunucu bağlantısı, kamera, dokunmatik kaydırma, sunucu olaylarının efektleri.
-- Arayüz (ui.gui_script) buraya mesajla komut yollar: join, send, leave, center.
local net = require("main.net")
local B = require("shared.balance")
local U = require("main.util")
local fx = require("main.fx")
local units = require("main.units")
local world = require("main.world")
local sfx = require("main.sfx")
local music = require("main.music")
local I = require("shared.i18n")

local UI = msg.url("main:/ui#gui")
local VIEW_H = 720
local GROUND_Y = U.GROUND_Y
local CONSENTED = 4000
local SOURCE_TINT = { gold = 0xffd34d, fury = 0xff6a3d, heal = 0x7dff9a }

local H_TOUCH = hash("touch")
local H_WHEEL_UP = hash("wheel_up")
local H_WHEEL_DOWN = hash("wheel_down")
local H_LEFT = hash("left")
local H_RIGHT = hash("right")

local function half_w()
	local w, h = window.get_size()
	if h <= 0 then return 640 end
	return w / h * VIEW_H / 2
end

local function on_screen(self, x)
	local hw = half_w()
	return x > self.cam_x - hw - 60 and x < self.cam_x + hw + 60
end

-- ── sunucu olaylarının dünya efektleri ───────────────────
local function cmd_fx(self, e)
	local v = units.views[e.id]
	local x = v and v.x or units.sx(e.x)
	local mine = e.side == net.side
	local y = GROUND_Y - 40
	local tier = v and v.tier or 0
	if e.k == "spawn" then
		fx.emit("glow" .. tier, 18, x, y)
		if mine then fx.float_text(x, GROUND_Y - 110, I.t("float.cmdArrives"), "#ffe08a") end
	elseif e.k == "leap" then
		units.leap(e.id, e.x)
		fx.emit("smoke", 4, x, GROUND_Y - 6)
		if on_screen(self, x) then sfx.play("special") end
	elseif e.k == "slam" then
		fx.ring(x, GROUND_Y - 8, 0xffd76a, 0.2, 0.08, B.CMD_SLAM_R / 26, B.CMD_SLAM_R / 70, 0.38, 960)
		fx.emit("chunks" .. tier, 14, x, GROUND_Y - 6)
		fx.emit("smoke", 6, x, GROUND_Y - 6)
		fx.emit("spark", 12, x, GROUND_Y - 20)
		fx.float_text(x, GROUND_Y - 120, I.t("cmd.skill") .. "!", mine and "#ffe08a" or "#ff9a9a")
		if on_screen(self, x) then
			fx.shake(0.14, 0.004)
			sfx.play("boom")
			music.duck()
			units.hitstop(0.08)
		end
	elseif e.k == "level" then
		fx.emit("glow" .. tier, 24, x, y)
		fx.ring(x, y, 0xffe08a, 0.2, 0.2, 2.4, 2.4, 0.5, 970)
		fx.float_text(x, GROUND_Y - 120, I.t("float.level", { n = e.lvl or 1 }), mine and "#ffe08a" or "#ffb0b0")
		if mine then sfx.play("evolve") end
	elseif e.k == "die" then
		fx.float_text(x, GROUND_Y - 110, I.t(mine and "float.cmdDownMine" or "float.cmdDownFoe"), mine and "#ff9a9a" or "#ffe08a")
	end
end

local function on_fx(self, e)
	local t = e.t
	if t == "special" then
		world.special_fx(e.tier, e.x0, e.x1)
	elseif t == "outpost" then
		local x = world.op_x(e.i)
		local mine = e.side == net.side
		if e.k == "destroyed" then
			world.explosion(x, GROUND_Y - 20, 2, 70)
			fx.emit("chunks0", 16, x, GROUND_Y - 40)
			fx.float_text(x, GROUND_Y - 130, I.t(mine and "float.outpostLost" or "float.outpostKill"), mine and "#ff9a9a" or "#ffd34d")
		elseif e.k == "built" then
			fx.emit("smoke", 6, x, GROUND_Y - 10)
			fx.emit("spark", 10, x, GROUND_Y - 60)
		elseif e.k == "captured" then
			fx.emit("spark", 8, x - 20, GROUND_Y - 80)
			fx.float_text(x, GROUND_Y - 120, I.t(mine and "float.pointTaken" or "float.pointLost"), mine and "#9fd0ff" or "#ff9a9a")
		end
	elseif t == "heal" then
		local x = units.sx(e.x)
		for _ = 1, 14 do fx.emit("heal", 1, x + (math.random() * 2 - 1) * e.r, GROUND_Y - 10 - math.random() * 30) end
		fx.float_text(x, GROUND_Y - 70, I.t("float.heal"), "#8dff9a")
	elseif t == "cmd" then
		cmd_fx(self, e)
	elseif t == "src" then
		local x = units.sx(e.x)
		fx.ring(x, GROUND_Y - 50, SOURCE_TINT[e.kind] or 0xffffff, 0.3, 0.3, 4, 4, 0.7, 970)
		fx.emit("glow4", e.k == "taken" and 40 or 20, x, GROUND_Y - 60)
		if on_screen(self, x) then sfx.play("evolve") end
		if e.k == "taken" then
			local info = B.SOURCE_KINDS[e.kind]
			local mine = e.side == net.side
			fx.float_text(x, GROUND_Y - 150, info and I.source_name(e.kind) or "", mine and "#9fffb0" or "#ff9a9a")
			if mine and e.kind == "heal" then
				for _ = 1, 30 do fx.emit("heal", 1, math.random(-100, B.WORLD_W + 100), GROUND_Y - 10 - math.random() * 40) end
			end
		end
	elseif t == "bounce" then
		local a, b = units.views[e.from], units.views[e.to]
		if a and b then
			fx.lightning({ { x = a.x, y = a.y - a.height * 0.5 }, { x = b.x, y = b.y - b.height * 0.5 } }, B.tier(e.tier).palette.glow)
		end
	elseif t == "ufx" then
		local v = units.views[e.id]
		if not v then return end
		local x, y = v.x, v.y - v.height * 0.6
		if e.k == "block" then
			fx.emit("spark", 4, x + v.dir * 14, y)
			if math.random() < 0.5 then fx.float_text(x, v.y - v.height - 16, I.t("float.block"), "#a8d8ff") end
		elseif e.k == "revive" then
			fx.emit("glow4", 24, x, y)
			fx.ring(x, y, 0xc9a8ff, 0.2, 0.2, 2.2, 2.2, 0.5, 970)
			fx.float_text(x, v.y - v.height - 16, I.t("float.revive"), "#d9c2ff")
			if on_screen(self, x) then sfx.play("evolve") end
		elseif e.k == "charge" then
			fx.emit("smoke", 4, x, v.y - 6)
			fx.emit("chunks" .. v.tier, 6, x + v.dir * 30, y)
			if on_screen(self, x) then
				fx.shake(0.08, 0.002)
				sfx.play("hit_heavy")
			end
		end
	end
end

-- ── oda ──────────────────────────────────────────────────
local function exit_room(self, code)
	net.room = nil
	net.side = -1
	units.clear()
	fx.clear()
	world.reset()
	music.menu()
	msg.post(UI, "left", { code = code or 0 })
end

local function enter_room(self, room)
	room:on_message("fx", function(e)
		if net.room ~= room or net.side < 0 then return end
		on_fx(self, e)
		msg.post(UI, "fx", e)
	end)
	room:on("leave", function(e)
		if net.room == room then exit_room(self, e and e.code or 0) end
	end)
	room:on("error", function(e)
		print("oda hatası", e and e.code, e and e.error)
	end)
	msg.post(UI, "joined")
end

local function bind_side(self, s)
	net.side = s
	units.set_side(s)
	world.set_side(s)
	world.reset()
	self.cam_x = world.WORLD_MIN
	msg.post(UI, "bound", { side = s })
end

-- ── yaşam döngüsü ────────────────────────────────────────
function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	fx.init({ fx = msg.url("#fxf"), add = msg.url("#addf"), text = msg.url("#textf") })
	units.init(msg.url("#unitf"))
	world.init({ fx = msg.url("#fxf"), add = msg.url("#addf"), bg = msg.url("#bgf"), castle = msg.url("#castlef"), text = msg.url("#textf") })
	units.on_screen = function(x) return on_screen(self, x) end
	units.op_x = world.op_x
	world.on_screen = units.on_screen
	units.sfx = sfx.play
	world.sfx = sfx.play
	world.duck = music.duck
	self.freeze = 0
	self.last_freeze = -1
	-- görüntüyü kısa bir an dondurur (vuruşun ağırlığı); sık tekrarlanmaz
	units.hitstop = function(sec)
		if self.time - self.last_freeze < 0.26 then return end
		self.last_freeze = self.time
		self.freeze = math.max(self.freeze, sec)
	end
	-- öldürülen düşmanın yerinden altın sayacına sikke uçur (arayüze ekran konumuyla)
	units.coin = function(x, y, n)
		local hw = half_w()
		local gx = (x - (self.cam_x - hw)) / (2 * hw) * (2 * hw)
		msg.post(UI, "coins", { x = gx, y = VIEW_H - y, n = n })
	end
	self.cam_x = B.WORLD_W / 2
	self.idle = 0
	self.time = 0
	self.drag = nil
	self.keys = {}
	net.cam_x = self.cam_x
	net.cam_half = half_w()
end

local function update_camera(self, dt)
	local hw = half_w()
	if net.room then
		if self.keys.left then self.cam_x = self.cam_x - 900 * dt end
		if self.keys.right then self.cam_x = self.cam_x + 900 * dt end
	else
		self.idle = self.idle + dt
		self.cam_x = B.WORLD_W / 2 + math.sin(self.idle * 0.1) * (B.WORLD_W / 2)
	end
	local lo, hi = world.WORLD_MIN + hw, world.WORLD_MAX - hw
	if lo > hi then self.cam_x = B.WORLD_W / 2 else self.cam_x = U.clamp(self.cam_x, lo, hi) end
	local sx, sy = fx.shake_offset()
	msg.post("@render:", "camera", { x = self.cam_x, sx = sx, sy = sy })
	net.cam_x = self.cam_x
	net.cam_half = hw
	return self.cam_x - hw
end

function update(self, dt)
	dt = math.min(dt, 0.05)
	self.time = self.time + dt
	music.update(dt) -- hit-stop müziği yavaşlatmasın
	-- hit-stop: görüntü bir an donar (sunucu akmaya devam eder, birimler sonra yetişir)
	if self.freeze > 0 then
		self.freeze = self.freeze - dt
		if self.freeze > 0 then dt = dt * 0.06 end
	end
	fx.update(dt)
	units.update(dt)
	local left = update_camera(self, dt)
	world.update(dt, left)
	local room = net.room
	local st = room and room.state
	if not st or not st.players then return end
	if net.side < 0 then
		local me = st.players:get(net.session)
		if me then bind_side(self, me.side) else return end
	end
	if st.units then
		world.sync(st, self.time)
		units.sync(st, dt, self.time)
	end
end

function on_message(self, message_id, message)
	if message_id == hash("join") then
		net.join(message, function(err, room)
			if err then
				msg.post(UI, "join_error", { text = err })
				return
			end
			enter_room(self, room)
		end)
	elseif message_id == hash("send") then
		net.send(message.t, message.p)
	elseif message_id == hash("leave") then
		local room = net.room
		if room then
			exit_room(self, CONSENTED)
			room:leave(true)
		end
	elseif message_id == hash("center") then
		self.cam_x = message.x
	end
end

function on_input(self, action_id, action)
	if action_id == H_TOUCH or action_id == nil then
		if action_id == H_TOUCH and action.pressed then
			self.drag = { x = action.screen_x, cam = self.cam_x }
		elseif action_id == H_TOUCH and action.released then
			self.drag = nil
		elseif self.drag and net.room then
			local _, wh = window.get_size()
			self.cam_x = self.drag.cam - (action.screen_x - self.drag.x) * VIEW_H / math.max(1, wh)
		end
	elseif action_id == H_WHEEL_UP then
		self.cam_x = self.cam_x - 60
	elseif action_id == H_WHEEL_DOWN then
		self.cam_x = self.cam_x + 60
	elseif action_id == H_LEFT then
		self.keys.left = not action.released
	elseif action_id == H_RIGHT then
		self.keys.right = not action.released
	end
end
